# Copy to .streamlit/secrets.toml (local) or paste into the app's Secrets on Streamlit Cloud.
# Never commit the real file. Every key is optional: without them the app is the public synthetic demo.

# LLM extractor (optional). Notes are sent to the provider only when the user turns the toggle on.
LLM_PROVIDER = "anthropic"          # or "openai"
ANTHROPIC_API_KEY = ""
CLAUDE_MODEL = "claude-opus-5-5"    # default when empty
# OPENAI_API_KEY = ""
# OPENAI_MODEL = ""
# LLM_EFFORT = "medium"             # low | medium | high
# CLAUDE_SERVER_FALLBACK = "true"   # set "false" behind Bedrock/Vertex/proxies

# Public emergency data (data.go.kr, 국립중앙의료원 전국 응급의료기관 정보 조회 서비스) — the *Decoding* key.
DATA_GO_KR_SERVICE_KEY = ""
# Capabilities the API does not report, maintained by the region (hpid list).
TRAUMA_CENTERS = []
PICU_HOSPITALS = []

# Durable append-only audit log (SQLite file). Streamlit Cloud's disk is reset on restart.
# AUDIT_DB_PATH = "data/audit.db"

# Accounts. Without [auth.users] the app is a public demo where everyone can do everything.
# Generate hashes with: python scripts/make_password_hash.py
# [auth.users.nurse_kim]
# name = "전원 간호사 김OO"
# role = "coordinator"              # viewer | coordinator | supervisor
# password_hash = "pbkdf2_sha256$600000$..."
